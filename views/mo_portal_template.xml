<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_my_home_inherit" inherit_id="portal.portal_my_home">
        <xpath expr="//div[@id='portal_client_category']" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/sale/static/src/img/bag.svg'"/>
                <t t-set="title">Manufacturing Orders</t>
                <t t-set="text">Track Manufacturing Orders</t>
                <t t-set="url" t-value="'/my/manufacturing'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
        </xpath>
    </template>

</odoo>
