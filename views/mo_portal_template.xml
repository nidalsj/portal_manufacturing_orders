<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_my_home_inherit" inherit_id="portal.portal_my_home">
        <xpath expr="//div[@id='portal_client_category']" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/portal_manufacturing_orders/static/src/img/docs.svg'" />
                <t t-set="title">Manufacturing Orders</t>
                <t t-set="text">Track Manufacturing Orders</t>
                <t t-set="url" t-value="'/my/manufacturing'" />
                <t t-set="config_card" t-value="True" />
            </t>
        </xpath>
    </template>

    <template id="portal_breadcrumbs_manufacturing" inherit_id="portal.portal_breadcrumbs" priority="20">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">

            <li t-if="page_name == 'manufacturing_orders'" class="breadcrumb-item active">
                Manufacturing Orders
            </li>
            <li t-if="manufacturing_order" class="breadcrumb-item">
                <a t-attf-href="/my/manufacturing?{{ keep_query() }}">Manufacturing Orders</a>
            </li>
            <li t-if="manufacturing_order" class="breadcrumb-item active">
                <t t-esc="manufacturing_order.name"/>
            </li>

        </xpath>
    </template>

    <!-- List View -->
    <template id="portal_manufacturing_list" name="My Manufacturing Orders">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Manufacturing Orders</t>
            </t>

            <div t-if="not manufacturing_orders" class="alert alert-warning" role="alert">
                There are currently no Manufacturing Orders
            </div>

            <t t-if="manufacturing_orders" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>MO Number</th>
                        <th class="text-start">Product</th>
                        <th class="text-end">Quantity</th>
                        <th class="text-center">Status</th>
                    </tr>
                </thead>
                <t t-foreach="manufacturing_orders" t-as="mo">
                    <tr>
                        <td>
                            <a t-att-href="'/my/manufacturing/%s' % mo.id">
                                <t t-out="mo.name"/>
                            </a>
                        </td>
                        <td><t t-out="mo.product_id.display_name"/></td>
                        <td class="text-end">
                            <t t-out="mo.product_qty"/> 
                            <t t-out="mo.product_uom_id.name"/>
                        </td>
                        <td class="text-center">
                            <span t-if="mo.state == 'draft'" class="badge bg-secondary">Draft</span>
                            <span t-if="mo.state == 'confirmed'" class="badge bg-info">Confirmed</span>
                            <span t-if="mo.state == 'progress'" class="badge bg-primary">In Progress</span>
                            <span t-if="mo.state == 'to_close'" class="badge bg-warning">To Close</span>
                            <span t-if="mo.state == 'done'" class="badge bg-success">Done</span>
                            <span t-if="mo.state == 'cancel'" class="badge bg-danger">Cancelled</span>
                        </td>
                    </tr>
                </t>
            </t>
        </t>
    </template>


    <!-- Form View -->
    <template id="portal_manufacturing_order_page" name="Manufacturing Order Portal">
        <t t-call="portal.portal_layout">
            <t t-set="o_portal_fullwidth_alert" groups="mrp.group_mrp_user">
                <t t-call="portal.portal_back_in_edit_mode">
                    <t t-set="backend_url"
                        t-value="'/web#model=%s&amp;id=%s&amp;action=%s&amp;view_type=form' % (manufacturing_order._name, manufacturing_order.id, manufacturing_order.env.ref('mrp.mrp_production_action').id)" />
                </t>
            </t>

            <div class="container mt-4 o_portal_manufacturing">
                <div class="row">
                    <!-- Sidebar -->
                    <t t-call="portal.portal_record_sidebar">
                        <t t-set="classes" t-value="'d-print-none col-lg-3 col-xl-4'"/>

                        <t t-set="title">
                            <h4 class="mb-0 text-primary">
                                <t t-esc="manufacturing_order.name"/>
                            </h4>
                            <span class="badge bg-secondary mt-1" t-esc="manufacturing_order.state"/>
                        </t>

                        <t t-set="entries">
                            <div class="d-flex flex-column gap-3 mt-3">
                                <div>
                                    <strong>Product:</strong><br/>
                                    <t t-esc="manufacturing_order.product_id.display_name"/>
                                </div>
                                <div>
                                    <strong>Quantity to Produce:</strong><br/>
                                    <t t-esc="manufacturing_order.product_qty"/> 
                                    <t t-esc="manufacturing_order.product_uom_id.name"/>
                                </div>
                                <div>
                                    <strong>Produced:</strong><br/>
                                    <t t-esc="manufacturing_order.qty_produced"/>
                                </div>
                                <div>
                                    <strong>Planned Start:</strong><br/>
                                    <t t-if="manufacturing_order.date_start">
                                        <t t-esc="manufacturing_order.date_start"/>
                                    </t>
                                    <t t-else="">Date not set</t>
                                </div>
                                <div>
                                    <strong>Planned Finish:</strong><br/>
                                    <t t-if="manufacturing_order.date_finished">
                                        <t t-esc="manufacturing_order.date_finished"/>
                                    </t>
                                    <t t-else="">Date not set</t>
                                </div>
                                <div>
                                    <strong>Responsible:</strong><br/>
                                    <t t-esc="manufacturing_order.user_id.name"/>
                                </div>

                                <a class="btn btn-secondary o_print_btn d-block"
                                    t-att-href="'/my/manufacturing/%s/print' % manufacturing_order.id"
                                    target="_blank">
                                        <i class="fa fa-print"/> Print Production Order
                                </a>
    
                            </div>
                        </t>
                    </t>

                    <!-- Main Content -->
                    <div class="col-lg-9 col-xl-8">
                        <div class="card mb-4">
                            <div class="card-body">
                                <h3 class="card-title">
                                    Manufacturing Order - <t t-esc="manufacturing_order.name"/>
                                </h3>
                                <hr/>
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <strong>Product:</strong><br/>
                                        <t t-esc="manufacturing_order.product_id.display_name"/>
                                    </div>
                                    <div class="col-md-6">
                                        <strong>Status:</strong><br/>
                                        <span class="badge bg-info" t-esc="manufacturing_order.state"/>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <strong>Quantity:</strong><br/>
                                        <t t-esc="manufacturing_order.product_qty"/> 
                                        <t t-esc="manufacturing_order.product_uom_id.name"/>
                                    </div>
                                    <div class="col-md-6">
                                        <strong>Produced:</strong><br/>
                                        <t t-esc="manufacturing_order.qty_produced"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Components -->
                        <div class="card mb-4">
                            <div class="card-body">
                                <h4>Components Used</h4>
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>Component</th>
                                            <th>Quantity</th>
                                            <th>UoM</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="manufacturing_order.move_raw_ids" t-as="move">
                                            <td><t t-esc="move.product_id.display_name"/></td>
                                            <td><t t-esc="move.product_uom_qty"/></td>
                                            <td><t t-esc="move.product_uom.name"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Chatter -->
                        <div class="card mb-4">
                            <div class="card-body">
                                <h4>Communication History</h4>
                                <t t-call="portal.message_thread">
                                    <t t-set="object" t-value="manufacturing_order"/>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>